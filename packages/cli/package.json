{
  "name": "toolveto",
  "version": "0.2.0",
  "description": "ToolVeto CLI — Block double-charge, crash, and context bombs in CI with a 3-line PR fix",
  "license": "MIT",
  "homepage": "https://toolveto.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolveto/toolveto.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/toolveto/toolveto/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toolveto",
    "cli",
    "ci-gate",
    "chaos-testing",
    "ai-agents",
    "security",
    "cedar",
    "opa"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "toolveto": "./dist/bin/toolveto.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/bin/toolveto.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "tsc --noEmit",
    "test": "node --test dist/src/__tests__/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@toolveto/core": "workspace:*",
    "@toolveto/shield": "workspace:*",
    "commander": "^13.1.0",
    "toolveto-gateway": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
