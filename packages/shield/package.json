{
  "name": "@toolveto/shield",
  "version": "0.2.0",
  "description": "ToolVeto Shield — Runtime Idempotency Deduplication, Loop Protection, and Token Budgeting Middleware for MCP Servers",
  "license": "BUSL-1.1",
  "homepage": "https://toolveto.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolveto/toolveto.git",
    "directory": "packages/shield"
  },
  "bugs": {
    "url": "https://github.com/toolveto/toolveto/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toolveto",
    "middleware",
    "idempotency",
    "loop-breaker",
    "token-budget",
    "ai-safety"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stores/redis": {
      "types": "./dist/stores/redis.d.ts",
      "default": "./dist/stores/redis.js"
    },
    "./stores/postgres": {
      "types": "./dist/stores/postgres.d.ts",
      "default": "./dist/stores/postgres.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "pg": ">=8.0.0",
    "ioredis": ">=5.0.0",
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "8.16.0",
    "pg": "8.20.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "lru-cache": "^11.5.3"
  }
}
