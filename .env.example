# ToolVeto Open-Source & Gateway Environment Secrets

# 1. Attestation JWS Signing Secret
# (Must match cloud verification secret if verifying cross-environment)
TOOLVETO_SIGNING_SECRET=toolveto-oss-evidence-secret

# 2. ToolVeto Shield Gateway Secret (Bearer Token Authorization)
TOOLVETO_GATEWAY_SECRET=toolveto-gateway-bearer-key-replace-me

# 3. Upstream API Keys (Interpolated in toolveto-gateway.yml)
STRIPE_API_KEY=sk_live_...
NEON_API_KEY=...
GITHUB_TOKEN=ghp_...
